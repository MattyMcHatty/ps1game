# Build output
build/

# Compiled binaries
*.exe
*.bin
*.BIN

# Disc images (large binary files)
*.cue
HORROR.cue
HORROR.bin

# Packaged playtest builds — the .bin/.cue inside are already covered by the
# globs above; this is the zip they get wrapped in for the website. Both are
# rebuilt from build/ + disc.xml, so only the hand-written README is tracked.
release/*.zip

# Generated artifacts (regenerable from tools/)
__pycache__/
tools/preview_4bpp.png

# subpack_uvs.py intermediates. <Level>.packed.smx is regenerated from the
# committed <Level>.smx plus tools/subpack/<level>.json on the way to the .smd,
# so it is a build step's scratch file, not an asset.
*.packed.smx
